# 실제 값을 채운 뒤 파일명을 .env 로 바꾸세요. (현재 스켈레톤은 MOCK_MODE=1 이라 없어도 동작)
MOCK_MODE=1

# LLM (벤더 중립 — 값은 env 로 주입. 코드에 벤더명·모델명을 박지 않는다)
# 2026-09-13 결정: Bedrock은 쓰지 않는다. [3-C]·[5] 문장 생성은 OpenAI만 쓴다.
# 실제 호출하려면 셋이 다 필요하다: MOCK_MODE=0 · LLM_PROVIDER=openai · LLM_MODEL · OPENAI_API_KEY
LLM_PROVIDER=mock
# 사용할 모델 id. 2026-10-01부터 기본 gpt-6-luna — gpt-4o-mini보다 토큰 단가가 싸고(아래
# SPEC_EXTRACTION_IMAGE_MODEL 코멘트 참고) [3-C]·[5] 문장 생성·조건 대화 에이전트 도구 호출
# 실측(2026-10-01)으로 품질·동작 확인됨. 콘솔에서 실제 쓸 모델을 확인해 넣는다
LLM_MODEL=gpt-6-luna
# 견적 점검 이미지(스크린샷) 사양 추출 전용 모델 — 기본은 LLM_MODEL과 별개로 gpt-6-luna. 캡처 속
# 모델번호를 gpt-4o-mini가 다른 실존 제품 번호로 잘못 읽는(환각) 사례가 실측돼, 이미지 1장짜리
# 저빈도 호출에만 실측으로 더 정확하고 더 싼 모델을 쓴다. 안 적으면 코드 기본값(gpt-6-luna)을 쓴다.
# SPEC_EXTRACTION_IMAGE_MODEL=gpt-6-luna
# OpenAI API 키. .env 는 .gitignore 이므로 이 예시 파일에는 실제 값을 절대 넣지 않는다
OPENAI_API_KEY=
# 조건 대화 에이전트 (Strands Agents SDK, src/agent/conditions_agent.py). 1 이면 조건 대화의 자유 텍스트를
# LLM 도구 호출로 반영한다 (위 셋이 다 있어야 실제로 켜진다). 기본 0 — 계약 §D-3 합의 전 opt-in.
CONDITIONS_AGENT=0
# 결과 화면 대화 에이전트 (Strands, src/agent/result_agent.py). 1 이면 결과 화면 입력칸의 자유 텍스트를
# LLM 도구 호출(후보 조회·교체·담기/빼기·수량·시점·근거 설명)로 처리한다. 기본 0 — 규칙(슬롯+저렴/좋은) 경로.
RESULT_AGENT=0
QUOTE_REVIEW_AGENT=0
# DB 미보유 부품·주변기기 실시간 스펙 검색(docs/미보유부품_실시간스펙검색_설계.md). 1이면 받은
# 견적 점검의 "대응 안 됨" 부품 버튼, 조건 대화·결과 화면 대화의 search_unavailable_part 도구가
# 실제 웹 검색+LLM 검증을 시도한다. 기본 0 — opt-in.
LIVE_PART_LOOKUP=0
# 아래 둘은 옛 pgvector RAG(Bedrock Titan) 변수다 — rag 스키마가 0011에서 삭제돼 라이브 경로는 읽지 않는다.
# [3-C]·[5]의 OpenAI 호출과 무관하니 비워 둔다.
LLM_REGION=
EMBEDDING_MODEL=

# RAG — "구매 전 확인" 부품 가이드 (src/rag/care_guides.py) — data/pc_care_guides.json 을 프로세스 시작 시
#    인메모리로 임베딩. MOCK_MODE=1 이면 해시 임베딩, 0 이면 OPENAI_API_KEY 로 아래 모델 호출.
# CARE_GUIDE_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL + pgvector (2번 작업에서 사용)
# DATABASE_URL=postgresql://truefit:truefit@localhost:5432/truefit

# DB 커넥션 풀 (src/db/__init__.py) — 서버 프로세스마다 따로 센다. (프로세스 수 × DB_POOL_MAX)가 DB 의 max_connections 를
# 넘지 않게 한다. 기다려도 연결을 못 얻으면(DB_POOL_TIMEOUT 초) 500 이 아니라 503(service_busy)로 답한다.
# 서버 스레드 한도가 40 이라 DB_POOL_MAX 를 40 보다 크게 잡아도 효과가 없다.
# DB_POOL_MIN=8
# DB_POOL_MAX=20
# DB_POOL_TIMEOUT=5
# 백그라운드 작업(추천 실행)은 요청 풀과 따로 연결을 가진다 — 요청이 몰려 풀이 차도 이미 접수한 추천이 연결을 못 얻어 실패하지 않게.
# 서버 프로세스 하나의 연결 수 = DB_POOL_MAX + DB_BACKGROUND_POOL_MAX (기본: RECOMMEND_WORKERS + RECOMMEND_EXPLAIN_WORKERS).
# DB_BACKGROUND_POOL_MAX=12

# LLM 호출 보호 (src/clients/llm_guard.py) — 모델이 느리거나 몰려도 서버가 같이 무너지지 않게 한다. 서버 프로세스마다 따로 센다.
# *_TIMEOUT_SECONDS: 호출 한 번을 기다리는 최대 시간(초). 넘으면 규칙 경로로 넘어간다(OpenAI SDK 기본은 600초).
# LLM_MAX_CONCURRENCY: 동시에 날아가는 모델 호출 수. 넘으면 LLM_QUEUE_TIMEOUT_SECONDS 초까지 줄을 서고, 그래도 자리가 없으면 규칙 경로.
# LLM_REQUEST_MAX: LLM 을 기다리며 DB 연결을 쥐는 요청(조건 대화·결과 대화·견적 점검 되묻기·실시간 검색 등)의 동시 수. 기본은 풀의
#   절반(DB_POOL_MAX/2) — 이 값을 풀 크기에 가깝게 올리면 LLM 요청이 몰릴 때 나머지 요청(목록·리포트·폴링)이 막힐 수 있다.
#   넘으면 503(llm_busy, Retry-After 3)이고, 프론트가 최대 2번 자동으로 다시 보낸다.
# LLM_TIMEOUT_SECONDS=45
# LLM_VISION_TIMEOUT_SECONDS=90
# LLM_SEARCH_TIMEOUT_SECONDS=60
# LLM_MAX_CONCURRENCY=12
# LLM_QUEUE_TIMEOUT_SECONDS=10
# LLM_REQUEST_MAX=10
# LLM_BACKGROUND_QUEUE_TIMEOUT_SECONDS=120   # 백그라운드(추천 설명 문장)는 모델 호출 자리를 이만큼 기다린다

# 추천 실행 전용 작업자 (src/services/recommendation_runner.py) — 요청 스레드 풀(40)과 분리. 서버 프로세스마다 따로 센다.
# RECOMMEND_WORKERS: 엔진 계산(CPU, DB 연결)을 동시에 돌리는 수. 넘치면 줄을 선다.
# RECOMMEND_EXPLAIN_WORKERS: 설명 문장(LLM, DB 연결 없음)을 동시에 만드는 수 — LLM_MAX_CONCURRENCY 이하로.
# RECOMMEND_STALE_SECONDS: 이보다 오래 running/pending 인 실행은 실패로 정리한다. 시작 직후 한 번은 RECOMMEND_STARTUP_STALE_SECONDS.
# RECOMMEND_SYNC=1 은 테스트용(요청 뒤 같은 스레드에서 끝까지 돌린다) — 운영에서는 켜지 않는다.
# RECOMMEND_WORKERS=4
# RECOMMEND_EXPLAIN_WORKERS=8
# RECOMMEND_STALE_SECONDS=600
# RECOMMEND_STARTUP_STALE_SECONDS=60
# RECOMMEND_REAP_INTERVAL_SECONDS=60

# 이메일+비밀번호 로그인 (src/auth, src/services/auth_service.py)
# 운영에서는 반드시 값을 바꾸세요 — 기본값을 그대로 쓰면 토큰 위조가 가능합니다.
JWT_SECRET=dev-only-change-me
# https로 서빙할 때만 1 (평문 http 개발 환경에서 Secure 쿠키는 브라우저가 거부합니다)
COOKIE_SECURE=0

# web/(vite, 기본 5173)을 mock이 아니라 이 백엔드에 붙여 띄울 때만 관계있습니다. 이 서버 자신의 origin(요청이
# 실제로 들어온 스킴+호스트)과 다른 Origin 헤더는 기본적으로 막습니다(src/auth/origin.py, CSRF 방지) —
# vite dev 서버는 프록시를 거쳐도 브라우저가 Origin: http://localhost:5173 또는 http://127.0.0.1:5173 을
# 그대로 보냅니다. 개발 환경(APP_ENV=production 이 아닐 때)은 이 둘을 기본으로 허용하므로(개발요청 12번,
# src/config.py _with_dev_origins) 보통은 이 줄이 필요 없습니다 — 운영 배포에서 프론트 주소를 추가할 때만 쓰세요.
# ALLOWED_ORIGINS=https://app.example.com
