# AWS 서버의 .env 견본 — 서버에서 `cp deploy/aws.env.example .env` 한 뒤 값을 채운다. .env 는 git 에 올라가지 않는다(.gitignore).
# 비밀번호·API 키·JWT_SECRET 을 이 견본 파일에 직접 적지 마세요(이 저장소는 공개입니다).

# ── 모드 ──
# 처음 스모크 테스트는 MOCK_MODE=1(LLM 호출 없음, 비용 없음)로, 실제 동작 확인은 0 으로.
MOCK_MODE=1
# HTTP(도메인·인증서 없음)로 서비스하는 동안은 development 로 둔다 — production 이면 로그인 쿠키가 Secure 전용이 되어
# HTTP 에서는 브라우저가 쿠키를 버려 로그인이 안 된다. (development 면 /dev/* 개발용 경로도 열리므로 보안 그룹에서 접근 IP 를 제한한다.)
APP_ENV=development
COOKIE_SECURE=0
# HTTPS 로 옮기면: APP_ENV=production, COOKIE_SECURE=1

# ── 보안 ── 반드시 새로 만든 값으로(서버에서: openssl rand -hex 32)
JWT_SECRET=

# ── DB (RDS) ── 비밀번호에 @ : / # ? 같은 문자가 있으면 퍼센트 인코딩해야 한다
DATABASE_URL=postgresql://사용자:비밀번호@RDS엔드포인트:5432/truefit_dev?sslmode=require

# ── 연결 풀 (RDS db.t3.small max_connections=191, 서버 프로세스 UVICORN_WORKERS 개 기준: 2 × (28 + 6) = 68) ──
DB_POOL_MIN=4
DB_POOL_MAX=28
DB_BACKGROUND_POOL_MAX=6

# ── 프로세스·작업자 (프로세스마다 따로 센다) ──
UVICORN_WORKERS=2
RECOMMEND_WORKERS=2
RECOMMEND_EXPLAIN_WORKERS=4
# 모델 호출 동시 수(프로세스당)와 LLM 을 기다리는 요청 수. 동시 30명 시험(R4)에서 5 이면 llm_busy 19회. LLM_REQUEST_MAX 는 DB_POOL_MAX 의 절반 이하,
# 모델 API 의 분당 한도(429)를 보면서 올린다. 추천 설명 작업자(RECOMMEND_EXPLAIN_WORKERS)가 이 호출 자리를 같이 쓴다.
LLM_MAX_CONCURRENCY=10
LLM_REQUEST_MAX=8

# ── LLM (MOCK_MODE=0 일 때만 필요) ──
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
OPENAI_API_KEY=
CONDITIONS_AGENT=1
RESULT_AGENT=1
QUOTE_REVIEW_AGENT=1
SPEC_EXTRACTION_AGENT=1
LIVE_PART_LOOKUP=1

# ── 주변기기 사용기 분석(개발요청 O-1) ── docker-compose.aws.yml 의 worker 컨테이너가 돈다
# 1 이면 커뮤니티 사용기 글을 언어 모델로 분석한다(MOCK_MODE=0 과 OPENAI_API_KEY 필요). 글 한 편당 모델 호출 1번 + 근거 문장 임베딩.
# 0 이면 분석하지 않고 글은 대기 상태로 남는다. 비용 상한은 아래 하루 한도(UTC 기준)다. 바뀌지 않은 글은 다시 분석하지 않는다.
PERIPHERAL_POST_AGENT=1
PERIPHERAL_POST_DAILY_LIMIT=200
# PERIPHERAL_POST_INTERVAL_SECONDS=60    # 대기 글을 확인하는 주기(초)
# 1 이면 주변기기 견적 문장을 언어 모델로 해석한다(문장마다 모델 호출). 0 이면 단어 규칙으로 읽는다.
PERIPHERAL_INTENT_AGENT=0

# ── 로그인·가입 시도 한도(같은 IP 기준 분당) ──
# LOGIN_LIMIT_PER_MIN_IP=20
# SIGNUP_LIMIT_PER_MIN_IP=10

# ── 커뮤니티 이미지 첨부 ── docker-compose.aws.yml 이 서버의 ./uploads 를 /app/uploads 로 마운트한다
COMMUNITY_UPLOAD_DIR=/app/uploads/community
# COMMUNITY_IMAGE_MAX_BYTES=5242880      # 파일당 5MB
# COMMUNITY_IMAGE_MAX_PER_POST=5
# COMMUNITY_IMAGE_MAX_SIDE_PX=1600
