# AWS 서버의 .env 견본 — 서버에서 `cp deploy/aws.env.example .env` 한 뒤 값을 채운다. .env 는 git 에 올라가지 않는다(.gitignore).
# 비밀번호·API 키·JWT_SECRET 을 이 견본 파일에 직접 적지 마세요(이 저장소는 공개입니다).

# ── 모드 ──
# 처음 스모크 테스트는 MOCK_MODE=1(LLM 호출 없음, 비용 없음)로, 실제 동작 확인은 0 으로.
MOCK_MODE=1
# HTTP(도메인·인증서 없음)로 서비스하는 동안은 development 로 둔다 — production 이면 로그인 쿠키가 Secure 전용이 되어
# HTTP 에서는 브라우저가 쿠키를 버려 로그인이 안 된다. (development 면 /dev/* 개발용 경로도 열리므로 보안 그룹에서 접근 IP 를 제한한다.)
APP_ENV=development
COOKIE_SECURE=0
# HTTPS 로 옮기면: APP_ENV=production, COOKIE_SECURE=1

# ── 보안 ── 반드시 새로 만든 값으로(서버에서: openssl rand -hex 32)
JWT_SECRET=

# ── DB (RDS) ── 비밀번호에 @ : / # ? 같은 문자가 있으면 퍼센트 인코딩해야 한다
DATABASE_URL=postgresql://사용자:비밀번호@RDS엔드포인트:5432/truefit_dev?sslmode=require

# ── 연결 풀 (RDS db.t3.micro max_connections=81, 서버 프로세스 UVICORN_WORKERS 개 기준) ──
DB_POOL_MIN=4
DB_POOL_MAX=10
DB_BACKGROUND_POOL_MAX=6

# ── 프로세스·작업자 (프로세스마다 따로 센다) ──
UVICORN_WORKERS=2
RECOMMEND_WORKERS=2
RECOMMEND_EXPLAIN_WORKERS=4
LLM_MAX_CONCURRENCY=6
LLM_REQUEST_MAX=5

# ── LLM (MOCK_MODE=0 일 때만 필요) ──
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
OPENAI_API_KEY=
CONDITIONS_AGENT=1
RESULT_AGENT=1
QUOTE_REVIEW_AGENT=1
SPEC_EXTRACTION_AGENT=1
LIVE_PART_LOOKUP=1
