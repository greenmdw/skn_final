# 이 파일을 복사해서 .env 로 이름을 바꾸고, 실제 값을 채워넣으세요.
# .env 파일 자체는 절대 git에 커밋하지 마세요 (.gitignore에 추가 권장).

# OpenAI API 키 (NEGOTIATOR_MODE=llm 일 때만 필요)
OPENAI_API_KEY=sk-여기에-발급받은-키-입력

# 협상 에이전트 모드: rule(기본값, 무료) 또는 llm(OpenAI 사용)
NEGOTIATOR_MODE=rule

# 협상에 사용할 OpenAI 모델 (NEGOTIATOR_MODE=llm 일 때만 사용, 기본값: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ── v5 분산 구조 (EC2 4대: Buyer / Seller1 / Seller2 / Broker) ──
# 어떤 서비스로 뜰지 (docker-compose.yml 의 app):
#   Buyer  EC2 → app.buyer_service:app     Seller EC2 → app.seller_service:app
APP_MODULE=app.main:app

# Buyer EC2: 중앙 브로커 위치
BROKER_URL=http://10.0.1.13:9000

# Broker EC2: 셀러 목록 (buyer 가 매 요청에 seller_endpoints 를 넘기면 생략 가능)
SELLER_ENDPOINTS=http://10.0.1.11:8000,http://10.0.1.12:8000
BROKER_MAX_ROUNDS=3

# Seller EC2: 이 인스턴스가 대표하는 판매사 (floor_price 는 이 서버 밖으로 안 나감)
SELLER_ID=한빛테크
SELLER_ITEM=NVIDIA L40S
SELLER_QTY=50
SELLER_OFFER_PRICE=11500000
SELLER_FLOOR_PRICE=9900000
SELLER_DESCRIPTION=Ada Lovelace 아키텍처; GDDR6 48GB ECC; PCIe 4.0 x16; 최대 소비전력 350W
SELLER_LEAD_TIME_DAYS=30
SELLER_MOQ=1
SELLER_TRUST_SCORE=100
SELLER_BUYER_TRUST_REQUIRED=0
SELLER_BULK_DISCOUNT_RATE=0
SELLER_BULK_DISCOUNT_MIN_QTY=0
SELLER_PAYMENT_TERMS=
SELLER_DELIVERY_TERMS=

# Odoo 19 JSON-2 연결 설정 (DB·API키 미설정 시 /api/integrations/odoo/health 는 NOT_CONFIGURED 로 정상 응답)
# ⚠️ ODOO_API_KEY 에 한글/비ASCII 를 넣으면 HTTP 헤더 인코딩 에러(500)가 납니다 — 비워두거나 실제 키만.
ODOO_BASE_URL=http://odoo:8069
ODOO_DATABASE=
ODOO_API_KEY=

# A 방식 — Odoo 를 협상의 거울로 사용 (seller: sale.order 미러 / buyer: purchase.order 폴링)
# ODOO_SYNC=on 이고 DB·API키가 채워져야 동작. off 면 협상만 하고 Odoo 는 안 건드림.
ODOO_SYNC=off
# buyer 백그라운드 폴러 간격(초). 0 = 수동(POST /api/odoo/pull)만.
ODOO_POLL_SECONDS=0
ODOO_CONNECT_TIMEOUT_SECONDS=3
ODOO_READ_TIMEOUT_SECONDS=10
ODOO_VERIFY_TLS=true
ODOO_ALLOW_INSECURE_HTTP=false
ODOO_EXPECTED_MAJOR_VERSION=19
ODOO_USER_AGENT=skn-final/0.1.0
