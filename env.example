# 이 파일을 복사해서 .env 로 이름을 바꾸고, 실제 값을 채워넣으세요.
# .env 파일 자체는 절대 git에 커밋하지 마세요 (.gitignore에 추가 권장).

# OpenAI API 키 (NEGOTIATOR_MODE=llm 일 때만 필요)
OPENAI_API_KEY=sk-여기에-발급받은-키-입력

# 협상 에이전트 모드: rule(기본값, 무료) 또는 llm(OpenAI 사용)
NEGOTIATOR_MODE=rule

# 협상에 사용할 OpenAI 모델 (NEGOTIATOR_MODE=llm 일 때만 사용, 기본값: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Odoo 19 JSON-2 연결 설정
# 실제 API 키는 .env 또는 운영 secret manager에만 저장하세요.
ODOO_BASE_URL=https://odoo.example.com
ODOO_DATABASE=your-odoo-database
ODOO_API_KEY=여기에-Odoo-전용-bot-API-key-입력
ODOO_CONNECT_TIMEOUT_SECONDS=3
ODOO_READ_TIMEOUT_SECONDS=10
ODOO_VERIFY_TLS=true
ODOO_ALLOW_INSECURE_HTTP=false
ODOO_EXPECTED_MAJOR_VERSION=19
ODOO_USER_AGENT=skn-final/0.1.0
